# =============================================================================
#  Konfiguracja dla trybu LOKALNEGO (Windows, run.bat - bez Dockera)
# =============================================================================
#  Skopiuj do backend\.env i uzupelnij tylko to, czego potrzebujesz:
#      copy backend\.env.example backend\.env
#
#  Ten plik dotyczy pracy lokalnej. Wdrozenie na VPS (Docker) konfiguruje sie
#  osobno w deploy\.env - wzorzec: deploy\.env.example
#
#  UWAGA: DATABASE_URL i SESSION_SECRET sa juz ustawiane przez deploy\run-api.bat
#  i deploy\run-worker.bat. Zmienne srodowiskowe maja pierwszenstwo przed tym
#  plikiem, wiec NIE trzeba ich tu podawac (i nie nadpisza ich wartosci stad).
#
#  Po zmianie tego pliku zrestartuj API i worker (zamknij okna i odpal run.bat).
# =============================================================================


# --- Nazwa firmy w raportach PDF ---------------------------------------------
# Pojawia sie na okladce i w stopce generowanego raportu.
COMPANY_NAME=Twoja Firma


# --- Asystent AI (OpenRouter) ------------------------------------------------
# Bez klucza: czat AI nie odpowiada, parser maili dziala tylko regulowo,
# a zestawienie tygodniowe generuje sie w wersji "baseline" (same liczby).
#
# Domyslny dostawca to OpenRouter - klucz z https://openrouter.ai/keys (zaczyna sie od "sk-or-").
# Jeden klucz daje dostep do modeli wielu dostawcow, w tym Claude.
OPENROUTER_API_KEY=

# Alternatywa: klucz bezposrednio z https://console.anthropic.com/
# Uzywany TYLKO gdy OPENROUTER_API_KEY jest puste (gdy ustawione sa oba, wygrywa OpenRouter).
ANTHROPIC_API_KEY=

# Modele - nazwy kanoniczne sa automatycznie tlumaczone na slugi OpenRoutera
# (claude-opus-4-8 -> anthropic/claude-opus-4.8). Mozna tez podac pelny slug z ukosnikiem,
# np. CHAT_MODEL=deepseek/deepseek-v4 - wtedy uzywany jest doslownie.
# Zostaw puste/niezmienione, jesli nie wiesz, co wybrac.
#CHAT_MODEL=claude-opus-4-8
#EMAIL_PARSER_MODEL=claude-haiku-4-5
# Model, do ktorego parser maili eskaluje przy niskiej pewnosci (ponizej 0,5).
# Puste = CHAT_MODEL. Ta sama wartosc co EMAIL_PARSER_MODEL wylacza eskalacje.
#EMAIL_PARSER_ESCALATION_MODEL=

# Nadpisanie adresu API (puste = adres domyslny dostawcy). Sam adres bez klucza = wlasny endpoint
# zgodny z Anthropic Messages API, np. lokalna atrapa modelu: python tools/mock_llm.py (AI_BASE_URL=http://127.0.0.1:8765).
#AI_BASE_URL=


# --- Powiadomienia e-mail (SMTP) ---------------------------------------------
# Bez tych danych powiadomienia sa po prostu pomijane (nic nie wychodzi).
# Wysylka: nowy szkic zamowienia z maila, dzienny digest alertow, zestawienie tygodniowe.
# Typowo: serwer SMTP dostawcy poczty / port 587 / HASLO APLIKACJI przy 2FA (nie haslo do konta!).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Nadawca i odbiorca - puste = uzyj SMTP_USER.
SMTP_FROM=
NOTIFY_EMAIL_TO=
# true dla portu 587 (STARTTLS), false dla 465 (SSL bezposrednie).
SMTP_STARTTLS=true
#
# Po uzupelnieniu sprawdz w panelu: Ustawienia -> Powiadomienia e-mail -> "Wyslij testowy".


# --- Skrzynka firmowa (IMAP) - zamowienia z maili ----------------------------
# Bez tego pipeline maili jest pomijany. Przy skrzynce z 2FA tez haslo aplikacji.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Ile dni wstecz zaciagnac przy pierwszym uruchomieniu.
IMAP_BACKFILL_DAYS=90
# Adres, z ktorego przychodza zgloszenia z formularza na stronie
# (rozroznienie "zamowienie z formularza" vs "wolny mail od klienta").
FORM_EMAIL_FROM=
FORM_EMAIL_SUBJECT_PREFIX=[Zamowienie ze strony]
# Zgloszenia wspolpracy (klub sportowy / hurtownik) z tej samej strony i tego samego nadawcy.
# Panel pokazuje je w Skrzynce osobno i NIE robi z nich szkicu zamowienia.
PARTNER_EMAIL_SUBJECT_PREFIX=[Wspolpraca ze strony]


# --- Meta: reklamy (Marketing API) + organic (Graph API) ---------------------
META_ACCESS_TOKEN=
# Format: act_1234567890
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_IG_USER_ID=


# --- Google Ads API ----------------------------------------------------------
# Wymaga pakietow Google: pip install -e ".[google]"
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Bez myslnikow, np. 1234567890
GOOGLE_ADS_CUSTOMER_ID=
# Tylko gdy konto jest pod kontem menedzera (MCC).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=


# --- Google Analytics 4 (Data API) -------------------------------------------
# Wymaga pakietow Google: pip install -e ".[google]"
# Cala zawartosc pliku JSON konta serwisowego w JEDNEJ linii.
GA4_SERVICE_ACCOUNT_JSON=
# Samo ID numeryczne, bez prefiksu "properties/".
GA4_PROPERTY_ID=


# --- RODO --------------------------------------------------------------------
# Po ilu dniach czyscic tresc OBSLUZONYCH maili (tekst, HTML, naglowki, metadane zalacznikow).
# 0 = nie kasuj. Zalecane 90-365 (patrz docs/07-rodo.md).
RAW_EMAIL_RETENTION_DAYS=0

# --- Maskowanie danych osobowych przed AI (polanon) ---
# Wartosci domyslne; po pierwszej zmianie w panelu (Ustawienia -> Prywatnosc AI) obowiazuje zapis w bazie.
# Wlaczone + polanon niedostepny = do modelu nic nie wychodzi (fail closed).
PII_MASKING_ENABLED=true
# Tryb NER (spaCy): pip install "polanon[ner]" && python -m spacy download pl_core_news_md
PII_MASKING_NER=false
