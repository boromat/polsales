# =============================================================================
#  PolSales - konfiguracja wdrozenia
# =============================================================================
#  Skopiuj do .env i uzupelnij:   cp .env.example .env
#  Plik .env NIE trafia do repozytorium (jest w .gitignore) - trzymaj go tylko
#  na serwerze. To jedyne miejsce na sekrety (decyzja kanoniczna #12: zadnych
#  kluczy w kodzie ani w panelu).
#
#  Legenda:  [WYMAGANE] - bez tego stack nie wstanie
#            [OPCJONALNE] - funkcja sama sie wylacza, gdy puste (graceful degradation)
# =============================================================================


# --- Baza danych -------------------------------------------------------------
# [WYMAGANE] Uzywane przez kontener `db` (docker-compose).
POSTGRES_USER=polsales
POSTGRES_PASSWORD=zmien_to_haslo_na_dlugie_losowe
POSTGRES_DB=polsales

# [WYMAGANE] Uzywane przez API i worker. Host `db` = nazwa uslugi w compose.
# Musi zgadzac sie z POSTGRES_* powyzej.
DATABASE_URL=postgresql+psycopg://polsales:zmien_to_haslo_na_dlugie_losowe@db:5432/polsales


# --- Domena i bezpieczenstwo -------------------------------------------------
# [WYMAGANE] Domena panelu - Caddy wystawi na nia certyfikat HTTPS (Let's Encrypt).
# Zostaw `localhost`, zeby testowac lokalnie bez certyfikatu.
# UWAGA: wartosc inna niz localhost/127.0.0.1 wlacza tryb produkcyjny:
#        ciasteczko sesji dostaje flage Secure, a aplikacja odmawia startu
#        przy domyslnych sekretach (patrz _guard_production w app/main.py).
APP_DOMAIN=panel.example.com

# [WYMAGANE] Klucz podpisujacy tokeny sesji (HMAC). Wygeneruj losowy, min. 64 znaki:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Zmiana tej wartosci wylogowuje wszystkie sesje.
SESSION_SECRET=wygeneruj_losowy_ciag_min_64_znaki

# [OPCJONALNE] Ile dni wazna jest sesja logowania (domyslnie 7).
SESSION_TTL_DAYS=7


# --- Logowanie przez Google (Cloudflare Access) ------------------------------
# [OPCJONALNE] Puste/false = logowanie wylacznie loginem i haslem (create_user).
#
# Wlaczone = tozsamosc ustala Cloudflare Access na brzegu (SSO Google + polityka
# mailowa), a aplikacja weryfikuje podpisany token z naglowka Cf-Access-Jwt-Assertion.
# Wymaga, zeby ruch do panelu szedl przez Cloudflare Access (np. Cloudflare Tunnel) - tylko
# wtedy naglowek z tokenem w ogole dociera. Logowanie haslem dziala dalej jako awaryjne
# wejscie, gdy zadnego tokenu nie ma.
CF_ACCESS_ENABLED=false

# Domena zespolu Zero Trust, BEZ https:// - np. twojafirma.cloudflareaccess.com
# Znajdziesz ja w Zero Trust -> Settings -> Custom Pages (albo w adresie ekranu logowania).
CF_ACCESS_TEAM_DOMAIN=

# Tag AUD aplikacji Access (dlugi ciag hex). Zero Trust -> Access -> Applications ->
# Twoja aplikacja -> Overview -> "Application Audience (AUD) Tag".
# Bez tego token wystawiony dla DOWOLNEJ innej aplikacji w tym samym zespole
# otwieralby panel - dlatego aplikacja nie wstanie z pustym AUD przy CF_ACCESS_ENABLED=true.
CF_ACCESS_AUD=

# [OPCJONALNE, ale zalecane] Drugie sito, po przecinku. Adres spoza tej listy nigdy
# nie zalozy nowego konta w panelu - wejdzie tylko wtedy, gdy konto juz istnieje.
CF_ACCESS_ALLOWED_EMAILS=
# true = wejscie WYLACZNIE przez Cloudflare Access: logowanie haslem wylaczone, cookie nie
# wystarcza. Zalecane, gdy serwer jest dostepny tylko przez tunel; publikujac porty 80/443
# bez tego trybu, Access da sie ominac wchodzac bezposrednio na adres serwera.
CF_ACCESS_ONLY=false


# --- Marka raportow ----------------------------------------------------------
# [OPCJONALNE] Nazwa firmy na okladce i w stopce raportu PDF (domyslnie "PolSales Demo").
COMPANY_NAME=Twoja Firma


# --- Asystent AI (OpenRouter) ------------------------------------------------
# [OPCJONALNE] Bez klucza: czat AI i parser maili AI sa nieaktywne, a zestawienie
# tygodniowe generuje sie w wersji "baseline" (z policzonych liczb, bez narracji AI).
#
# Domyslny dostawca to OpenRouter - klucz z https://openrouter.ai/keys ("sk-or-...").
# Uzywamy jego endpointu zgodnego z Anthropic Messages API, wiec tool use i streaming
# dzialaja tak samo jak u Anthropica.
OPENROUTER_API_KEY=

# [OPCJONALNE] Alternatywa: klucz z https://console.anthropic.com/
# Brany pod uwage TYLKO gdy OPENROUTER_API_KEY jest puste.
ANTHROPIC_API_KEY=

# [OPCJONALNE] Modele. Nazwy kanoniczne sa tlumaczone na slugi OpenRoutera automatycznie
# (claude-opus-4-8 -> anthropic/claude-opus-4.8). Pelny slug z ukosnikiem uzywany doslownie.
CHAT_MODEL=claude-opus-4-8
EMAIL_PARSER_MODEL=claude-haiku-4-5
# Model eskalacji parsera przy niskiej pewnosci (ponizej 0,5). Puste = CHAT_MODEL.
# Ta sama wartosc co EMAIL_PARSER_MODEL wylacza eskalacje.
EMAIL_PARSER_ESCALATION_MODEL=

# [OPCJONALNE] Nadpisanie adresu API (puste = adres domyslny dostawcy).
AI_BASE_URL=


# --- Skrzynka firmowa (IMAP) - zamowienia z maili ----------------------------
# [OPCJONALNE] Bez tych danych pipeline maili jest pomijany (job sie rejestruje,
# ale konczy statusem "skipped"). Przy skrzynce z 2FA uzyj hasla aplikacji, nie glownego.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Ile dni wstecz zaciagnac przy pierwszym uruchomieniu.
IMAP_BACKFILL_DAYS=90

# [OPCJONALNE] Adres, z ktorego przychodza zgloszenia z formularza na stronie
# (rozpoznawanie "zamowienie z formularza" vs "wolny mail od klienta").
FORM_EMAIL_FROM=
FORM_EMAIL_SUBJECT_PREFIX=[Zamowienie ze strony]
# Zgloszenia wspolpracy (klub sportowy / hurtownik) z tej samej strony i tego samego nadawcy.
# Panel pokazuje je w Skrzynce osobno i NIE robi z nich szkicu zamowienia.
PARTNER_EMAIL_SUBJECT_PREFIX=[Wspolpraca ze strony]


# --- Powiadomienia e-mail (SMTP) ---------------------------------------------
# [OPCJONALNE] Bez tych danych powiadomienia sa pomijane (nic nie wychodzi).
# Wysylka: nowy szkic zamowienia, alerty biznesowe, zestawienie tygodniowe.
# Typowo: serwer SMTP dostawcy poczty / port 587 / haslo aplikacji (przy 2FA).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Nadawca (domyslnie SMTP_USER) i odbiorca powiadomien (domyslnie tez SMTP_USER).
SMTP_FROM=
NOTIFY_EMAIL_TO=
# STARTTLS (587) = true; SSL/TLS bezposrednie (465) = false.
SMTP_STARTTLS=true


# --- Meta: Marketing API (reklamy) + Graph API (organic) ---------------------
# [OPCJONALNE] Bez tokena synchronizacja Meta jest pomijana.
# Token dlugowieczny z https://developers.facebook.com/
META_ACCESS_TOKEN=
# Format: act_1234567890
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_IG_USER_ID=


# --- Pakiety opcjonalne backendu ---------------------------------------------
# [OPCJONALNE] Extras z backend/pyproject.toml instalowane w obrazie api i worker.
# GA4 i Google Ads wymagaja "google"; tryb NER maskowania - "ner". Kilka: google,ner
# Po zmianie: docker compose up -d --build
BACKEND_EXTRAS=


# --- Google Ads API ----------------------------------------------------------
# [OPCJONALNE] Bez kompletu synchronizacja Google Ads jest pomijana.
# Wymaga BACKEND_EXTRAS=google (bez tego panel pokaze komunikat o brakujacym pakiecie).
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Bez myslnikow, np. 1234567890
GOOGLE_ADS_CUSTOMER_ID=
# Konto menedzera (MCC) - tylko gdy konto jest pod MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=


# --- Google Analytics 4 (Data API) -------------------------------------------
# [OPCJONALNE] Bez tego synchronizacja GA4 jest pomijana. Wymaga BACKEND_EXTRAS=google.
# Cala zawartosc pliku JSON konta serwisowego w JEDNEJ linii (bez znakow nowej linii).
GA4_SERVICE_ACCOUNT_JSON=
# Samo ID numeryczne, bez prefiksu "properties/".
GA4_PROPERTY_ID=


# --- RODO --------------------------------------------------------------------
# [OPCJONALNE] Po ilu dniach kasowac surowa tresc maili (body/naglowki/zalaczniki).
# 0 = nie kasuj (domyslnie). Zalecane 90-365, zgodnie z docs/07-rodo.md.
# Czyszczona jest tresc obsluzonych maili (tekst, HTML, naglowki, metadane zalacznikow);
# nadawca, temat, status i dane zamowien zostaja. Maile czekajace na weryfikacje - nietkniete.
RAW_EMAIL_RETENTION_DAYS=0

# --- Maskowanie danych osobowych przed AI (polanon) ---
# Wartosci domyslne; po pierwszej zmianie w panelu (Ustawienia -> Prywatnosc AI) obowiazuje zapis w bazie.
# Wlaczone + polanon niedostepny = do modelu nic nie wychodzi (fail closed).
PII_MASKING_ENABLED=true
# Tryb NER (spaCy): pip install "polanon[ner]" && python -m spacy download pl_core_news_md
PII_MASKING_NER=false
